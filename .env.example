ENVIRONMENT=production
DATABASE_URL=postgresql://korvexa_app:replace-with-a-strong-password@127.0.0.1:5432/korvexa
TEST_DATABASE_URL=postgresql://korvexa_test:replace-with-a-strong-password@127.0.0.1:5432/korvexa_test
TEST_DATABASE_SCHEMA=korvexa_test
JWT_SECRET=replace-with-at-least-64-random-characters
VITE_API_BASE_URL=http://34.29.31.163
VITE_PUBLIC_APP_URL=http://34.29.31.163
PUBLIC_API_BASE_URL=https://replace-with-your-domain.example
CORS_ORIGINS=http://34.29.31.163
FRONTEND_RESET_URL=https://replace-with-your-domain.example/reset-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USERNAME=your-google-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=Korvexa <your-google-email@gmail.com>
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=rzp_live_or_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret
RAZORPAYX_KEY_ID=rzpx_live_or_test_key_id
RAZORPAYX_KEY_SECRET=rzpx_live_or_test_key_secret
RAZORPAYX_ACCOUNT_NUMBER=your_razorpayx_customer_identifier
RAZORPAYX_WEBHOOK_SECRET=your_razorpayx_webhook_signing_secret
ZOMATO_API_BASE_URL=https://your-zomato-api-base-url.example
ZOMATO_API_TOKEN=your_zomato_pos_integration_token
ZOMATO_AUTH_HEADER=Authorization
ZOMATO_AUTH_SCHEME=Bearer
ZOMATO_OUTLET_ID=your_zomato_outlet_id
ZOMATO_WEBHOOK_SECRET=your_zomato_webhook_secret
ZOMATO_WEBHOOK_AUTH_HEADER=Authorization
ZOMATO_WEBHOOK_AUTH_SCHEME=Bearer
SWIGGY_API_BASE_URL=https://your-swiggy-api-base-url.example
SWIGGY_API_TOKEN=your_swiggy_pos_integration_token
SWIGGY_AUTH_HEADER=Authorization
SWIGGY_AUTH_SCHEME=Bearer
SWIGGY_OUTLET_ID=your_swiggy_outlet_id
SWIGGY_WEBHOOK_SECRET=your_swiggy_webhook_secret
SWIGGY_WEBHOOK_AUTH_HEADER=Authorization
SWIGGY_WEBHOOK_AUTH_SCHEME=Bearer
# Override these after Swiggy/Zomato give exact partner paths, if different.
ZOMATO_ACCEPTED_PATH=/online-ordering/v1/order/confirm
ZOMATO_REJECTED_PATH=/online-ordering/v1/order/reject
ZOMATO_READY_PATH=/online-ordering/v1/order/ready
ZOMATO_PICKED_UP_PATH=/online-ordering/v1/order/pickedup
ZOMATO_DELIVERED_PATH=/online-ordering/v1/order/delivered
SWIGGY_ACCEPTED_PATH=/orders/{external_order_id}/accept
SWIGGY_REJECTED_PATH=/orders/{external_order_id}/reject
SWIGGY_READY_PATH=/orders/{external_order_id}/ready
SWIGGY_PICKED_UP_PATH=/orders/{external_order_id}/picked-up
SWIGGY_DELIVERED_PATH=/orders/{external_order_id}/delivered
